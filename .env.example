# Base de données — Neon (docker-compose fournit une alternative locale sur
# le port 5433, non utilisée en pratique depuis la Phase 2.5).
# DATABASE_URL : endpoint Neon POOLED (host se terminant par "-pooler"),
# utilisé par le runtime applicatif — seul mode compatible serverless
# (Vercel). DIRECT_URL : endpoint Neon DIRECT (sans "-pooler"), utilisé
# uniquement par le CLI Prisma pour les migrations.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Session
SESSION_SECRET="change-me-to-a-long-random-string-in-production"

# WhatsApp — mode: mock (dev, code loggué serveur) | meta (production, requiert
# les deux variables ci-dessous — get-provider.ts lève une erreur explicite si
# WHATSAPP_PROVIDER_MODE=meta sans elles, jamais un repli silencieux vers mock)
WHATSAPP_PROVIDER_MODE="mock"
WHATSAPP_META_ACCESS_TOKEN=""
WHATSAPP_META_PHONE_NUMBER_ID=""
# Nom exact du template WhatsApp Authentication approuvé par Meta pour l'OTP —
# requis uniquement si WHATSAPP_PROVIDER_MODE=meta (sinon échec explicite,
# jamais de repli silencieux vers un message texte libre, voir
# WhatsAppVerificationService)
WHATSAPP_META_OTP_TEMPLATE_NAME=""
# Nom exact du template WhatsApp Utility approuvé par Meta pour l'événement
# REQUEST_RECEIVED — voir src/lib/notifications/meta-template-map.ts. Les
# autres événements NotificationEvent n'ont volontairement pas encore de
# template Meta configuré (périmètre pilote).
WHATSAPP_META_TEMPLATE_REQUEST_RECEIVED=""

# OTP
OTP_TTL_MINUTES="5"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"

# Stockage fichiers — mode: local (dev, écrit sous public/uploads) | vercel-blob (production)
STORAGE_PROVIDER_MODE="local"
# Requis uniquement si STORAGE_PROVIDER_MODE="vercel-blob" — provisionné
# automatiquement par Vercel dès qu'un store Blob est attaché au projet,
# à définir manuellement en local pour tester ce mode.
BLOB_READ_WRITE_TOKEN=""
