# Base de données (docker-compose fournit une instance locale sur le port 5433)
DATABASE_URL="postgresql://chicano:chicano_dev_password@localhost:5433/chicano?schema=public"

# Session
SESSION_SECRET="change-me-to-a-long-random-string-in-production"

# WhatsApp — mode: mock (dev, code loggué serveur) | meta (production)
WHATSAPP_PROVIDER_MODE="mock"
WHATSAPP_META_ACCESS_TOKEN=""
WHATSAPP_META_PHONE_NUMBER_ID=""
WHATSAPP_META_APP_SECRET=""

# OTP
OTP_TTL_MINUTES="5"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"

# Stockage fichiers — mode: local (dev, écrit sous public/uploads) | s3 (à implémenter)
STORAGE_PROVIDER_MODE="local"
