// CHICANO AUTO SERVICES — schema de données plateforme
// Couvre le modèle minimum de la section 62 du cahier des charges.
// Phase 1 (Auth + vérification WhatsApp) : entièrement câblée côté application.
// Les autres modèles sont posés dès maintenant pour ne pas bloquer les phases
// suivantes sur des migrations tardives, mais leur logique métier n'est pas
// encore implémentée (cf. PHASE 2+ dans docs/ROADMAP.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITÉ / ACCÈS
// ============================================================

enum UserRole {
  CUSTOMER
  TECHNICIAN
  PRODUCTION_STAFF
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  BLOCKED
}

model User {
  id                  String        @id @default(cuid())
  firstName           String
  lastName             String
  email               String?       @unique
  phoneRaw            String
  phoneE164           String        @unique
  passwordHash        String
  role                UserRole      @default(CUSTOMER)
  status              AccountStatus @default(PENDING_VERIFICATION)
  whatsappVerified    Boolean       @default(false)
  whatsappVerifiedAt  DateTime?
  termsAcceptedAt     DateTime
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customerProfile     Customer?
  technicianProfile   Technician?
  whatsappVerifications WhatsappVerification[]
  auditLogs           AuditLog[]    @relation("AuditLogActor")
  notifications       Notification[]
  sessions            Session[]
  campaignsCreated    Campaign[]
  interactionsLogged  CustomerInteraction[]
  followUpsAssigned   FollowUp[]    @relation("FollowUpAssignedTo")
  followUpsCreated    FollowUp[]    @relation("FollowUpCreatedBy")

  @@index([phoneE164])
  @@index([status])
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  tokenHash     String   @unique
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Vérification OTP WhatsApp — section 62 : ne jamais stocker l'OTP en clair.
model WhatsappVerification {
  id            String    @id @default(cuid())
  userId        String
  phoneNumber   String
  codeHash      String
  expiresAt     DateTime
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  consumedAt    DateTime?
  verifiedAt    DateTime?
  lastSentAt    DateTime  @default(now())
  resendCount   Int       @default(0)
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phoneNumber])
}

// ============================================================
// PROFILS
// ============================================================

model Customer {
  id            String   @id @default(cuid())
  userId        String   @unique
  companyId     String?
  crmStage      CrmStage @default(NEW)
  crmSource     CrmSource?
  // Segmentation commerciale (Phase 10) — distincte de crmStage (entonnoir
  // pré-client, Phase 0). INDIVIDUAL par défaut, ne présuppose jamais un
  // client existant PROFESSIONAL/BUSINESS/FLEET sans action explicite.
  customerType  CustomerType @default(INDIVIDUAL)
  // Consentement (Phase 10) — absent avant cette phase, confirmé par audit.
  // Défaut false partout : aucun consentement marketing n'est présumé pour
  // un client déjà existant, voir docs/CRM.md.
  whatsappOptIn    Boolean  @default(false)
  emailOptIn       Boolean  @default(false)
  smsOptIn         Boolean  @default(false)
  marketingOptIn   Boolean  @default(false)
  consentGivenAt   DateTime?
  consentSource    String?
  consentRevokedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company?  @relation(fields: [companyId], references: [id])
  vehicles      Vehicle[]
  serviceRequests ServiceRequest[]
  appointments  Appointment[]
  quotesAccepted Quote[] @relation("QuoteAcceptedBy")
  invoices      Invoice[]
  payments      Payment[]
  leads         Lead[]
  workOrders    WorkOrder[]
  careSubscriptions CareSubscription[]
  interactions  CustomerInteraction[]
  followUps     FollowUp[]
  referralsSent     Referral[] @relation("ReferralReferrer")
  referralsReceived Referral[] @relation("ReferralReferred")
}

enum CustomerType {
  INDIVIDUAL
  PROFESSIONAL
  BUSINESS
  FLEET
}

enum CrmStage {
  NEW
  CONTACTED
  QUALIFIED
  APPOINTMENT
  CUSTOMER
  LOST
}

enum CrmSource {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  WEBSITE
  REFERRAL
  COMPANY
  PARTNER
  CAR_DEALER
  OTHER
}

model Lead {
  id          String    @id @default(cuid())
  customerId  String?
  fullName    String
  phoneE164   String?
  source      CrmSource @default(OTHER)
  stage       CrmStage  @default(NEW)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer    Customer? @relation(fields: [customerId], references: [id])
}

enum TechnicianSkill {
  MECHANICAL
  DIAGNOSTIC
  ELECTRICAL
  ELECTRONICS
  HYBRID
  EV
  KEY_PROGRAMMING
}

model Technician {
  id            String    @id @default(cuid())
  userId        String    @unique
  skills        TechnicianSkill[]
  isAvailable   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments   TechnicianAssignment[]
  diagnostics   Diagnostic[]
  workOrders    WorkOrder[]
  workOrderItems WorkOrderItem[]
}

// ============================================================
// ENTREPRISES / FLOTTES (B2B — architecture préparée, P2)
// ============================================================

model Company {
  id          String   @id @default(cuid())
  name        String
  taxId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customers   Customer[]
  fleets      Fleet[]
}

model Fleet {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  createdAt   DateTime @default(now())

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicles    Vehicle[]
  contracts   FleetContract[]
}

model FleetContract {
  id          String   @id @default(cuid())
  fleetId     String
  reference   String   @unique
  startDate   DateTime
  endDate     DateTime?
  terms       String?
  createdAt   DateTime @default(now())

  fleet       Fleet    @relation(fields: [fleetId], references: [id], onDelete: Cascade)
}

// ============================================================
// VÉHICULES
// ============================================================

enum FuelType {
  ESSENCE
  DIESEL
  HYBRID
  PLUGIN_HYBRID
  ELECTRIC
  OTHER
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  CVT
  DCT
  OTHER
}

// Carrosserie du véhicule (section 2 de la Phase 2). Valeurs centralisées
// côté application dans src/lib/vehicles/options.ts — ne pas disperser les
// libellés dans le code.
enum VehicleBodyType {
  SEDAN
  SUV
  FOUR_BY_FOUR
  VAN
  PICKUP
  OTHER
}

enum VehicleStatus {
  ACTIVE
  ARCHIVED
}

// Immatriculation malienne — MVP volontairement simplifié à la seule règle de
// format LL CCC LL (2 lettres, 3 chiffres, 2 lettres). Toute donnée
// territoriale (région/arrondissement/cercle) a été explicitement écartée du
// modèle — voir docs/VEHICLE-REGISTRATION-MALI.md, section "Version MVP" et
// src/lib/vehicles/registration/plate.ts pour le parsing/la validation.
enum PlateDataStatus {
  // Immatriculation validée avec succès contre le format LL CCC LL.
  STRUCTURED
  // Valeur conservée telle quelle (licensePlate), non validée contre le
  // nouveau format sans inventer de donnée — état par défaut de toute donnée
  // existante avant l'introduction de cette validation.
  LEGACY_NEEDS_REVIEW
}

// Source d'un relevé de kilométrage — préparation des rappels d'entretien
// (section 10 de la Phase 2).
enum MileageSource {
  CUSTOMER
  TECHNICIAN
  SYSTEM
}

model Vehicle {
  id                    String   @id @default(cuid())
  // Compteur natif Postgres (identity/serial) — source atomique et sûre en
  // cas de créations concurrentes pour dériver chicanoVehicleId. Jamais
  // utilisé comme clé primaire ni exposé tel quel au client.
  sequenceNumber        Int      @unique @default(autoincrement())
  chicanoVehicleId      String   @unique // CHC-VH-000001 — identifiant métier lisible
  customerId            String
  fleetId               String?
  make                  String
  model                 String
  trim                  String?
  year                  Int?
  bodyType              VehicleBodyType?
  fuelType              FuelType @default(OTHER)
  // Détail libre du moteur (ex. "2.4L Turbo Diesel", "V6 3.5L") — distinct du
  // carburant (fuelType), qui reste la valeur structurée/filtrable.
  engine                String?
  transmission          TransmissionType?
  // Chaîne normalisée complète (ex. "AB123CD") — validée contre le format
  // LL CCC LL quand plateDataStatus = STRUCTURED (voir
  // src/lib/vehicles/registration/plate.ts). Conservée telle quelle pour les
  // véhicules existants avant l'introduction de cette validation
  // (plateDataStatus = LEGACY_NEEDS_REVIEW) — jamais réinterprétée
  // automatiquement.
  licensePlate          String?  @unique
  plateDataStatus       PlateDataStatus @default(LEGACY_NEEDS_REVIEW)
  vin                   String?
  mileage               Int?
  color                 String?
  firstRegisteredAt     DateTime?
  notes                 String?
  isPrimary             Boolean  @default(false)
  status                VehicleStatus @default(ACTIVE)
  archivedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  customer              Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fleet                 Fleet?   @relation(fields: [fleetId], references: [id])
  photos                VehiclePhoto[]
  mileageReadings       MileageReading[]
  serviceRequests       ServiceRequest[]
  appointments          Appointment[]
  diagnostics           Diagnostic[]
  quotes                Quote[]
  workOrders            WorkOrder[]
  invoices              Invoice[]
  maintenancePlans      MaintenancePlan[]
  maintenanceReminders  MaintenanceReminder[]
  careSubscriptions     CareSubscription[]

  @@index([customerId])
  @@index([customerId, isPrimary])
  @@index([vin])
}

model VehiclePhoto {
  id          String   @id @default(cuid())
  vehicleId   String
  url         String
  storageKey  String?
  caption     String?
  createdAt   DateTime @default(now())

  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

// Historique des relevés kilométriques — le champ Vehicle.mileage reste le
// relevé courant (dénormalisé pour affichage rapide), cette table conserve
// l'historique nécessaire aux futurs rappels d'entretien.
model MileageReading {
  id          String   @id @default(cuid())
  vehicleId   String
  value       Int
  source      MileageSource @default(CUSTOMER)
  recordedAt  DateTime @default(now())
  notes       String?

  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt])
}

// ============================================================
// DEMANDES DE SERVICE / URGENCE / LOCALISATION
// ============================================================

enum ServiceCategory {
  DIAGNOSTIC
  MAINTENANCE
  REPAIR
  ELECTRICAL
  KEY_PROGRAMMING
  PRE_PURCHASE_INSPECTION
  ASSISTANCE
  TECHNICAL_VISIT_PREP
  OTHER
}

enum InterventionType {
  AT_GARAGE
  MOBILE
}

enum ServiceRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  RESCHEDULE_REQUESTED
  CANCELLED
  COMPLETED
}

enum UrgencyReason {
  VEHICLE_IMMOBILIZED
  ENGINE_WONT_START
  BATTERY
  ELECTRICAL_FAILURE
  FLAT_TIRE
  CRITICAL_WARNING_LIGHT
  ACCIDENT
  OTHER
}

enum LocationSource {
  GPS
  MANUAL
}

model ServiceRequest {
  id                String   @id @default(cuid())
  // Compteur natif Postgres, même principe que Vehicle.sequenceNumber
  // (section 3 Phase 2) — dérive un identifiant métier lisible et unique
  // sans verrou applicatif, atomique même sous création concurrente.
  sequenceNumber    Int      @unique @default(autoincrement())
  referenceNumber   String   @unique // CHC-SR-000001
  customerId        String
  vehicleId         String
  category          ServiceCategory
  description       String
  interventionType  InterventionType
  isUrgent          Boolean  @default(false)
  urgencyReason     UrgencyReason?
  // Description courte obligatoire côté application si isUrgent = true
  // (section "RÈGLE MÉTIER IMPORTANTE" de la Phase 3).
  urgencyDescription String?
  preferredDate     DateTime?
  preferredSlot     String? // ex. "08:00-10:00" — voir lib/service-requests/options.ts
  status            ServiceRequestStatus @default(SUBMITTED)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  attachments       ServiceRequestAttachment[]
  location          RequestLocation?
  appointment       Appointment?
  workOrders        WorkOrder[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
}

model ServiceRequestAttachment {
  id               String   @id @default(cuid())
  serviceRequestId String
  url              String
  type             String // photo | video | document
  createdAt        DateTime @default(now())

  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
}

// Localisation liée à une demande — jamais publique (section 22).
model RequestLocation {
  id               String   @id @default(cuid())
  serviceRequestId String   @unique
  latitude         Float?
  longitude        Float?
  accuracy         Float?
  address          String?
  city             String?
  district         String?
  commune          String?
  neighborhood     String?
  landmark         String?
  locationSource   LocationSource @default(MANUAL)
  capturedAt       DateTime @default(now())

  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
}

// ============================================================
// RENDEZ-VOUS / AFFECTATION TECHNICIEN
// ============================================================

enum AppointmentStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  RESCHEDULE_REQUESTED
  ASSIGNED
  TECHNICIAN_EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id                String   @id @default(cuid())
  serviceRequestId  String   @unique
  customerId        String
  vehicleId         String
  scheduledDate     DateTime?
  scheduledSlot     String?
  interventionType  InterventionType
  status            AppointmentStatus @default(PENDING)
  notes             String?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  serviceRequest    ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  location          AppointmentLocation?
  assignments       TechnicianAssignment[]
  diagnostics       Diagnostic[]
  workOrders        WorkOrder[]

  @@index([status])
  @@index([scheduledDate])
}

model AppointmentLocation {
  id               String   @id @default(cuid())
  appointmentId    String   @unique
  latitude         Float?
  longitude        Float?
  accuracy         Float?
  address          String?
  city             String?
  district         String?
  commune          String?
  neighborhood     String?
  landmark         String?
  locationSource   LocationSource @default(MANUAL)
  capturedAt       DateTime @default(now())

  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

enum AssignmentStatus {
  ASSIGNED
  EN_ROUTE
  ARRIVED
  COMPLETED
  REASSIGNED
}

model TechnicianAssignment {
  id             String   @id @default(cuid())
  appointmentId  String
  technicianId   String
  status         AssignmentStatus @default(ASSIGNED)
  departedAt     DateTime?
  arrivedAt      DateTime?
  createdAt      DateTime @default(now())

  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  technician     Technician  @relation(fields: [technicianId], references: [id])

  @@index([technicianId])
}

// ============================================================
// DIAGNOSTIC
// ============================================================

enum CheckResult {
  NORMAL
  TO_MONITOR
  ANOMALY
  CRITICAL
  NOT_CHECKED
}

enum CheckCategory {
  ENGINE
  TRANSMISSION
  BRAKING
  SUSPENSION
  STEERING
  ELECTRICAL
  ELECTRONICS
  AIR_CONDITIONING
  BATTERY
  SAFETY
}

enum DiagnosticStatus {
  IN_PROGRESS
  COMPLETED
  REPORT_PUBLISHED
}

model Diagnostic {
  id             String   @id @default(cuid())
  appointmentId  String
  vehicleId      String
  technicianId   String
  mileageAtVisit Int?
  symptoms       String?
  status         DiagnosticStatus @default(IN_PROGRESS)
  startedAt      DateTime @default(now())
  completedAt    DateTime?

  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  vehicle        Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  technician     Technician  @relation(fields: [technicianId], references: [id])
  checks         DiagnosticCheck[]
  faultCodes     DiagnosticFaultCode[]
  report         DiagnosticReport?
  quotes         Quote[]

  @@index([vehicleId])
}

model DiagnosticCheck {
  id             String   @id @default(cuid())
  diagnosticId   String
  category       CheckCategory
  result         CheckResult @default(NOT_CHECKED)
  observation    String?

  diagnostic     Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)

  @@unique([diagnosticId, category])
}

model DiagnosticFaultCode {
  id             String   @id @default(cuid())
  diagnosticId   String
  device         String?
  deviceBrand    String?
  deviceModel    String?
  system         String?
  code           String
  description    String?
  measurement    String?
  observation    String?
  recommendation String?
  createdAt      DateTime @default(now())

  diagnostic     Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
}

enum SeverityLevel {
  URGENT
  UPCOMING
  TO_MONITOR
  NORMAL
}

model DiagnosticReport {
  id             String   @id @default(cuid())
  sequenceNumber Int      @unique @default(autoincrement())
  diagnosticId   String   @unique
  reportNumber   String   @unique
  conclusion     String?
  severity       SeverityLevel @default(NORMAL)
  publishedAt    DateTime?
  publishedById  String?
  createdAt      DateTime @default(now())

  diagnostic     Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  photos         ReportPhoto[]
  workOrders     WorkOrder[]
}

model ReportPhoto {
  id             String   @id @default(cuid())
  reportId       String
  url            String
  caption        String?

  report         DiagnosticReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

// ============================================================
// DEVIS / ORDRES DE TRAVAIL
// ============================================================

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  MODIFICATION_REQUESTED
  EXPIRED
}

model Quote {
  id              String   @id @default(cuid())
  sequenceNumber  Int      @unique @default(autoincrement())
  quoteNumber     String   @unique
  diagnosticId    String
  vehicleId       String
  currentVersion  Int      @default(1)
  status          QuoteStatus @default(DRAFT)
  totalAmount     Decimal? @db.Decimal(12, 2)
  currency        String   @default("XOF")
  acceptedAt      DateTime?
  acceptedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  diagnostic      Diagnostic @relation(fields: [diagnosticId], references: [id])
  vehicle         Vehicle    @relation(fields: [vehicleId], references: [id])
  acceptedBy      Customer?  @relation("QuoteAcceptedBy", fields: [acceptedById], references: [id])
  versions        QuoteVersion[]
  workOrder       WorkOrder?
  invoices        Invoice[]

  @@index([status])
}

model QuoteVersion {
  id              String   @id @default(cuid())
  quoteId         String
  versionNumber   Int
  laborAmount     Decimal? @db.Decimal(12, 2)
  travelAmount    Decimal? @db.Decimal(12, 2)
  discountAmount  Decimal? @db.Decimal(12, 2)
  totalAmount     Decimal? @db.Decimal(12, 2)
  leadTimeDays    Int?
  terms           String?
  createdAt       DateTime @default(now())

  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  items           QuoteItem[]

  @@unique([quoteId, versionNumber])
}

model QuoteItem {
  id              String   @id @default(cuid())
  quoteVersionId  String
  partId          String?
  label           String
  quantity        Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal  @db.Decimal(12, 2)

  quoteVersion    QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  part            Part?    @relation(fields: [partId], references: [id])
  workOrderItems  WorkOrderItem[]
}

// Work Order (Phase 7) — remplace le placeholder posé en Phase 0 (jamais
// exploité, confirmé vide sur Neon avant cette migration : voir
// docs/WORK-ORDERS.md). Créé automatiquement par acceptQuote() (jamais par
// une route de création manuelle) — voir la règle "QUOTE ACCEPTED →
// WORK ORDER CREATED" de docs/WORK-ORDERS.md.
enum WorkOrderStatus {
  DRAFT
  READY
  SCHEDULED
  IN_PROGRESS
  WAITING_PARTS
  QUALITY_CHECK
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum WorkOrderPriority {
  NORMAL
  URGENT
}

model WorkOrder {
  id              String   @id @default(cuid())
  // Même principe que les autres références métier (Vehicle.sequenceNumber
  // etc.) — jamais la clé primaire.
  sequenceNumber  Int      @unique @default(autoincrement())
  workOrderNumber String   @unique // CHC-WO-000001
  customerId      String
  vehicleId       String
  serviceRequestId String
  appointmentId   String?
  // Un seul Work Order par devis accepté — Quote.status = ACCEPTED est un
  // état terminal (aucun chemin de code ne permet d'en sortir), donc cette
  // contrainte d'unicité suffit à empêcher un doublon.
  quoteId         String   @unique
  // Figé à la création depuis Quote.currentVersion — jamais recalculé même
  // si le cycle de vie du devis évoluait un jour après ACCEPTED (voir
  // docs/WORK-ORDERS.md, section "Version du devis").
  acceptedQuoteVersionNumber Int
  diagnosticReportId String?
  technicianId    String?
  status          WorkOrderStatus @default(DRAFT)
  priority        WorkOrderPriority @default(NORMAL)
  scheduledDate   DateTime?
  internalNotes   String?
  // Contrôle qualité obligatoire avant COMPLETED (voir assertTransition côté
  // service — jamais appliqué au niveau du schéma).
  qualityCheckPassed   Boolean?
  qualityCheckNotes    String?
  qualityCheckedById   String?
  qualityCheckedAt     DateTime?
  testDrivePerformed   Boolean  @default(false)
  testDriveNotes       String?
  // Travaux supplémentaires découverts en cours de réparation — signal léger
  // uniquement (jamais de modification silencieuse du devis accepté, voir
  // docs/WORK-ORDERS.md).
  additionalWorkRequested Boolean @default(false)
  additionalWorkNotes     String?
  // Intervention mobile où la réparation s'avère impossible sur place — la
  // trace réelle de l'embarquement reste WorkshopTransfer ; ce flag signale
  // juste que la situation a été rencontrée.
  requiresTowing  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer        Customer @relation(fields: [customerId], references: [id])
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  serviceRequest  ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
  quote           Quote    @relation(fields: [quoteId], references: [id])
  diagnosticReport DiagnosticReport? @relation(fields: [diagnosticReportId], references: [id])
  technician      Technician? @relation(fields: [technicianId], references: [id])

  items           WorkOrderItem[]
  parts           WorkOrderPart[]
  photos          WorkOrderPhoto[]
  transfer        WorkshopTransfer?
  invoice         Invoice?

  @@index([customerId])
  @@index([vehicleId])
  @@index([serviceRequestId])
  @@index([appointmentId])
  @@index([technicianId])
  @@index([status])
  @@index([createdAt])
}

enum WorkOrderItemType {
  LABOR
  PART
  SERVICE
  OTHER
}

enum WorkOrderItemStatus {
  PENDING
  DONE
}

// Ligne de travaux — les lignes approuvées proviennent du devis accepté
// (sourceQuoteItemId), jamais saisies librement par un technicien (voir
// règle "ne pas permettre à un technicien de modifier silencieusement le
// périmètre financier approuvé").
model WorkOrderItem {
  id                String   @id @default(cuid())
  workOrderId       String
  type              WorkOrderItemType
  description       String
  quantity          Decimal  @default(1) @db.Decimal(10, 2)
  unit              String?
  unitPrice         Decimal? @db.Decimal(12, 2)
  totalPrice        Decimal? @db.Decimal(12, 2)
  sourceQuoteItemId String?
  status            WorkOrderItemStatus @default(PENDING)
  // Main-d'œuvre (type = LABOR) : suivi durée estimée/réelle par technicien.
  estimatedMinutes  Int?
  actualMinutes     Int?
  technicianId      String?
  // Phase 8 — rattache cette ligne à une opération du carnet d'entretien
  // (voir MaintenanceType). Optionnel : la plupart des lignes de réparation
  // ne correspondent à aucun entretien planifié.
  maintenanceType   MaintenanceType?
  // Phase 9 — coût CHICANO (achat pièce, coût horaire interne...), distinct
  // du prix client (unitPrice/totalPrice ci-dessus). Jamais exposé au
  // client — voir docs/BILLING.md, section "Marge".
  costPrice         Decimal? @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  workOrder         WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  sourceQuoteItem   QuoteItem? @relation(fields: [sourceQuoteItemId], references: [id])
  technician        Technician? @relation(fields: [technicianId], references: [id])
  invoiceItems      InvoiceItem[]

  @@index([workOrderId])
}

enum WorkOrderPartStatus {
  REQUESTED
  AVAILABLE
  ORDERED
  RECEIVED
  INSTALLED
  NOT_REQUIRED
}

// Gestion opérationnelle des pièces nécessaires à UN Work Order — volontairement
// pas un ERP de stock (pas de rapprochement avec Inventory.quantity dans cette
// phase, voir docs/WORK-ORDERS.md).
model WorkOrderPart {
  id            String   @id @default(cuid())
  workOrderId   String
  partId        String?
  label         String
  reference     String?
  quantity      Int      @default(1)
  status        WorkOrderPartStatus @default(REQUESTED)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part          Part?     @relation(fields: [partId], references: [id])

  @@index([workOrderId])
}

enum WorkOrderPhotoPhase {
  BEFORE
  AFTER
}

// Photos avant/après — modèle relationnel dédié (cohérent avec VehiclePhoto/
// ReportPhoto), pas un tableau photoUrls brut.
model WorkOrderPhoto {
  id          String   @id @default(cuid())
  workOrderId String
  phase       WorkOrderPhotoPhase
  url         String
  storageKey  String?
  caption     String?
  createdAt   DateTime @default(now())

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

// Embarquement garage — intervention mobile où la réparation s'avère
// impossible sur place (voir WorkOrder.requiresTowing). Volontairement
// minimal (pas de système de remorquage complet) : conserve l'Appointment
// initial, ne fait que tracer le transfert.
model WorkshopTransfer {
  id              String   @id @default(cuid())
  workOrderId     String   @unique
  reason          String
  vehicleCondition String?
  photoUrls       String[]
  destination     String?
  transferredById String?
  transferredAt   DateTime @default(now())
  receivedAt      DateTime?

  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

// ============================================================
// PIÈCES / STOCK
// ============================================================

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contact     String?
  createdAt   DateTime @default(now())

  parts       Part[]
}

model Part {
  id          String   @id @default(cuid())
  reference   String   @unique
  name        String
  supplierId  String?
  purchasePrice Decimal? @db.Decimal(12, 2)
  salePrice     Decimal? @db.Decimal(12, 2)
  quality       String?
  origin        String?
  createdAt     DateTime @default(now())

  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  inventory     Inventory?
  quoteItems    QuoteItem[]
  workOrderParts WorkOrderPart[]
}

model Inventory {
  id            String   @id @default(cuid())
  partId        String   @unique
  quantity      Int      @default(0)
  threshold     Int      @default(0)
  updatedAt     DateTime @updatedAt

  part          Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
}

// ============================================================
// FACTURATION
// ============================================================

// Facturation (Phase 9) — étend le placeholder posé en Phase 0 (confirmé
// vide sur Neon avant modification). Le devis accepté reste la référence
// commerciale, le Work Order la référence opérationnelle, la facture la
// référence financière (voir docs/BILLING.md). Aucun régime fiscal inventé
// — discount/travelFee/tax restent des montants libres, configurables.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id                 String   @id @default(cuid())
  sequenceNumber     Int      @unique @default(autoincrement())
  invoiceNumber      String   @unique // CHC-FAC-000001
  customerId         String
  vehicleId          String
  workOrderId        String?  @unique
  quoteId            String?
  // Figé à la création depuis WorkOrder.acceptedQuoteVersionNumber — jamais
  // recalculé (même principe que WorkOrder, voir docs/WORK-ORDERS.md).
  quoteVersionNumber Int?
  status             InvoiceStatus @default(DRAFT)
  subtotal           Decimal  @default(0) @db.Decimal(12, 2)
  discount           Decimal  @default(0) @db.Decimal(12, 2)
  travelFee          Decimal  @default(0) @db.Decimal(12, 2)
  tax                Decimal  @default(0) @db.Decimal(12, 2)
  total              Decimal  @default(0) @db.Decimal(12, 2)
  amountPaid         Decimal  @default(0) @db.Decimal(12, 2)
  balanceDue         Decimal  @default(0) @db.Decimal(12, 2)
  currency           String   @default("XOF")
  issuedAt           DateTime?
  dueAt              DateTime?
  paidAt             DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer  Customer   @relation(fields: [customerId], references: [id])
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])
  quote     Quote?     @relation(fields: [quoteId], references: [id])
  items     InvoiceItem[]
  payments  Payment[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([dueAt])
}

enum InvoiceItemType {
  LABOR
  PART
  SERVICE
  TRAVEL
  OTHER
}

// Snapshot du prix réellement facturé — reprend WorkOrderItem (déjà lui-même
// un snapshot figé du devis accepté depuis la Phase 7), jamais recalculé
// depuis une valeur mutable du devis.
model InvoiceItem {
  id                    String   @id @default(cuid())
  invoiceId             String
  type                  InvoiceItemType
  description           String
  quantity              Decimal  @default(1) @db.Decimal(10, 2)
  unit                  String?
  unitPrice             Decimal  @db.Decimal(12, 2)
  total                 Decimal  @db.Decimal(12, 2)
  sourceWorkOrderItemId String?

  invoice             Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sourceWorkOrderItem WorkOrderItem? @relation(fields: [sourceWorkOrderItemId], references: [id])

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  ORANGE_MONEY
  MOOV_MONEY
  WAVE
  BANK_TRANSFER
  OTHER
}

// FAILED couvre aussi une tentative Mobile Money via un provider non
// configuré (jamais enregistrée comme CONFIRMED) — voir
// src/lib/payments/providers/, docs/BILLING.md.
enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model Payment {
  id                   String   @id @default(cuid())
  sequenceNumber       Int      @unique @default(autoincrement())
  paymentNumber        String   @unique // CHC-PAY-000001
  invoiceId            String
  customerId           String
  amount               Decimal  @db.Decimal(12, 2)
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  externalReference    String?
  transactionReference String?
  proofUrl             String?
  notes                String?
  // Posé uniquement une fois le paiement CONFIRMED — le reçu est une
  // référence sur le paiement, pas une table séparée (voir docs/BILLING.md).
  receiptNumber        String?  @unique // CHC-RC-000001
  paidAt               DateTime?
  createdAt            DateTime @default(now())

  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([invoiceId])
  @@index([customerId])
}

// ============================================================
// CARNET NUMÉRIQUE / RAPPELS
// ============================================================

// Carnet automobile (Phase 8) — étendu depuis le placeholder posé en Phase 0
// (confirmé vide sur Neon avant modification). Volontairement pas une liste
// universelle imposée : chaque MaintenancePlan reste rattaché à UN véhicule,
// créé manuellement par la production (aucune génération automatique depuis
// marque/modèle — aucune source constructeur vérifiée disponible, voir
// docs/MAINTENANCE.md).
enum MaintenanceType {
  OIL_CHANGE
  OIL_FILTER
  AIR_FILTER
  FUEL_FILTER
  BRAKES
  BRAKE_FLUID
  TIRES
  BATTERY
  AIR_CONDITIONING
  TIMING_BELT
  SPARK_PLUGS
  TRANSMISSION
  COOLANT
  TECHNICAL_INSPECTION
  PERIODIC_SERVICE
  OTHER
}

model MaintenancePlan {
  id              String   @id @default(cuid())
  vehicleId       String
  type            MaintenanceType
  intervalKm      Int?
  intervalMonths  Int?
  priority        WorkOrderPriority @default(NORMAL)
  isActive        Boolean  @default(true)
  lastDoneAt      DateTime?
  lastDoneMileage Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reminders       MaintenanceReminder[]

  @@index([vehicleId])
}

// PENDING/SCHEDULED se recouvrent volontairement (un rappel créé
// automatiquement depuis un plan démarre SCHEDULED ; PENDING reste
// disponible pour un rappel créé manuellement sans échéance encore fixée) —
// voir docs/MAINTENANCE.md.
enum ReminderStatus {
  PENDING
  SCHEDULED
  SENT
  COMPLETED
  CANCELLED
}

// Niveau d'alerte progressif (section "RAPPELS PROGRESSIFS") — calculé à la
// volée depuis dueAt/dueMileage, jamais stocké comme source de vérité ;
// lastNotifiedLevel sert uniquement à ne jamais renvoyer deux fois la même
// alerte (anti-spam).
enum MaintenanceReminderLevel {
  UPCOMING
  DUE
  OVERDUE
}

model MaintenanceReminder {
  id                 String   @id @default(cuid())
  vehicleId          String
  planId             String?
  type               MaintenanceType
  dueAt              DateTime?
  dueMileage         Int?
  priority           WorkOrderPriority @default(NORMAL)
  status             ReminderStatus @default(SCHEDULED)
  notes              String?
  lastNotifiedLevel  MaintenanceReminderLevel?
  lastNotifiedAt     DateTime?
  // Traçabilité "entretien réalisé" (section 17) — un client ne peut jamais
  // déclarer lui-même un rappel complété, seul un WorkOrder COMPLETED le
  // peut (voir work-orders/service.ts::passQualityCheck).
  completedByWorkOrderId String?
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  vehicle            Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  plan               MaintenancePlan? @relation(fields: [planId], references: [id])

  @@index([vehicleId])
  @@index([status])
}

// ============================================================
// NOTIFICATIONS (WhatsApp / email / SMS)
// ============================================================

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
  IN_APP
}

enum NotificationEvent {
  ACCOUNT_VERIFIED
  REQUEST_RECEIVED
  REQUEST_ACCEPTED
  REQUEST_REJECTED
  RESCHEDULE_REQUESTED
  APPOINTMENT_ACCEPTED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  TECHNICIAN_ASSIGNED
  TECHNICIAN_EN_ROUTE
  TECHNICIAN_ARRIVED
  DIAGNOSTIC_COMPLETED
  REPORT_AVAILABLE
  QUOTE_AVAILABLE
  QUOTE_ACCEPTED
  REPAIR_COMPLETED
  VEHICLE_READY
  INVOICE_AVAILABLE
  MAINTENANCE_REMINDER
  // Work Order (Phase 7) — QUALITY_CHECK_REQUIRED et ADDITIONAL_WORK_REQUIRED
  // sont des signaux internes production (pas de mécanisme de diffusion à
  // l'équipe dans ce projet) : posés ici pour complétude mais jamais envoyés
  // via sendNotification(), voir docs/WORK-ORDERS.md.
  WORK_ORDER_CREATED
  WORK_SCHEDULED
  WORK_STARTED
  WORK_WAITING_PARTS
  QUALITY_CHECK_REQUIRED
  WORK_COMPLETED
  ADDITIONAL_WORK_REQUIRED
  // Carnet automobile (Phase 8) — remplacent en pratique l'ancien
  // MAINTENANCE_REMINDER générique (conservé pour ne pas casser son
  // template déjà seedé, mais plus utilisé par le nouveau code). REPAIR_
  // COMPLETED/VEHICLE_READY (déjà posés en Phase 0) sont réutilisés tels
  // quels pour signaler un entretien terminé — pas de nouvel événement
  // SERVICE_COMPLETED, voir docs/MAINTENANCE.md.
  MAINTENANCE_UPCOMING
  MAINTENANCE_DUE
  MAINTENANCE_OVERDUE
  // Facturation (Phase 9).
  INVOICE_ISSUED
  PAYMENT_RECEIVED
  PAYMENT_PARTIAL
  INVOICE_PAID
  PAYMENT_FAILED
  // CRM & CHICANO CARE (Phase 10).
  CARE_STARTED
  CARE_EXPIRING
  CARE_EXPIRED
  FOLLOW_UP_DUE
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

model NotificationTemplate {
  id            String   @id @default(cuid())
  event         NotificationEvent @unique
  channel       NotificationChannel @default(WHATSAPP)
  bodyTemplate  String
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  event         NotificationEvent
  channel       NotificationChannel
  status        NotificationStatus @default(PENDING)
  payload       Json?
  sentAt        DateTime?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  action        String
  entity        String
  entityId      String
  oldValue      Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  user          User?    @relation("AuditLogActor", fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
}

// ============================================================
// CRM, CHICANO CARE & CROISSANCE COMMERCIALE (Phase 10)
// ============================================================
//
// Segmentation comportementale (NEW/ACTIVE/RECURRING/DORMANT/AT_RISK/VIP) et
// parcours client (PROSPECT→...→CARE_CUSTOMER) ne sont PAS stockés ici —
// calculés à la volée depuis les données réelles (ServiceRequest/WorkOrder/
// Invoice/MaintenanceReminder/CareSubscription), même discipline que
// MaintenanceReminderLevel (Phase 8) : jamais de champ dupliqué à
// resynchroniser. Voir src/lib/crm/segmentation.ts et docs/CRM.md.

enum CampaignObjective {
  MAINTENANCE
  SEASONAL_CHECK
  BATTERY
  TYRES
  TRAVEL_CHECK
  REACTIVATION
  CARE
}

// Mêmes valeurs que la segmentation comportementale calculée (voir plus
// haut) — sert de critère de ciblage pour une campagne, jamais stocké côté
// Customer.
enum CampaignSegment {
  NEW
  ACTIVE
  RECURRING
  DORMANT
  AT_RISK
  VIP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

// Campagne minimale (pas un moteur de marketing automation) — un envoi
// n'est jamais déclenché automatiquement, toujours via une action
// production explicite après un mode PREVIEW. Voir docs/CRM.md.
model Campaign {
  id            String   @id @default(cuid())
  name          String
  objective     CampaignObjective
  segment       CampaignSegment
  channel       NotificationChannel
  message       String
  status        CampaignStatus @default(DRAFT)
  scheduledAt   DateTime?
  sentCount     Int      @default(0)
  skippedCount  Int      @default(0)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy     User     @relation(fields: [createdById], references: [id])

  @@index([status])
  @@index([segment])
}

// Offre commerciale CHICANO CARE — prix/durée/fréquence libres, jamais
// imposés en dur dans le code (voir docs/CHICANO-CARE.md).
model CarePlan {
  id               String   @id @default(cuid())
  name             String
  description      String?
  price            Int
  durationMonths   Int
  frequencyMonths  Int
  includedServices String[]
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions    CareSubscription[]
}

enum CareSubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

// vehicleId nullable : un abonnement peut être rattaché à un véhicule
// précis ou au compte client dans son ensemble. AUCUN paiement récurrent
// automatique ici — les paiements restent exactement ceux de la Phase 9
// (recordPayment manuel), voir docs/CHICANO-CARE.md.
model CareSubscription {
  id          String   @id @default(cuid())
  customerId  String
  vehicleId   String?
  carePlanId  String
  status      CareSubscriptionStatus @default(ACTIVE)
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  carePlan    CarePlan @relation(fields: [carePlanId], references: [id])

  @@index([customerId])
  @@index([status])
}

enum InteractionType {
  CALL
  WHATSAPP
  EMAIL
  SMS
  NOTE
  APPOINTMENT
  FOLLOW_UP
}

// Historique d'échanges avec un client — jamais exposé au client lui-même
// (RBAC réservé à la production), contenu sensible visible uniquement par
// le personnel habilité. Voir docs/CRM.md.
model CustomerInteraction {
  id          String   @id @default(cuid())
  customerId  String
  type        InteractionType
  subject     String?
  content     String?
  actorId     String
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actor       User     @relation(fields: [actorId], references: [id])

  @@index([customerId])
  @@index([createdAt])
}

enum FollowUpStatus {
  PENDING
  DONE
  CANCELLED
}

// Relance commerciale — motif + prochaine action, créable en production.
model FollowUp {
  id            String   @id @default(cuid())
  customerId    String
  reason        String
  dueAt         DateTime
  status        FollowUpStatus @default(PENDING)
  notes         String?
  assignedToId  String?
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo    User?    @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id])
  createdBy     User     @relation("FollowUpCreatedBy", fields: [createdById], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([dueAt])
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  CANCELLED
}

// Architecture PRÉPARATOIRE uniquement — pas de système d'affiliation
// complet (pas de calcul de récompense automatique dans cette phase).
model Referral {
  id                  String   @id @default(cuid())
  referrerCustomerId  String
  referredCustomerId  String   @unique
  status              ReferralStatus @default(PENDING)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  referrer            Customer @relation("ReferralReferrer", fields: [referrerCustomerId], references: [id])
  referred            Customer @relation("ReferralReferred", fields: [referredCustomerId], references: [id])

  @@index([referrerCustomerId])
}
